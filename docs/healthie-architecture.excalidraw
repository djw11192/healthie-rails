      "seed": 353222507,
      "version": 1,
      "versionNonce": 1347442259,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1780865264818,
      "link": null,
      "locked": false,
      "text": "HIPAA / security notes\n- TLS 1.2+ everywhere; PHI encrypted at rest (KMS),\n  field-level encryption for journal bodies\n- Signed BAA with cloud provider\n- Audit every PHI read/write (immutable log)\n- Least-privilege IAM; network isolation (VPC)\n- MFA + short-lived tokens; deny-by-default AuthZ\n- Automated encrypted backups + PITR\n- Read replicas: route writes/read-after-write to\n  primary, stale-tolerant reads to replicas",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "HIPAA / security notes\n- TLS 1.2+ everywhere; PHI encrypted at rest (KMS),\n  field-level encryption for journal bodies\n- Signed BAA with cloud provider\n- Audit every PHI read/write (immutable log)\n- Least-privilege IAM; network isolation (VPC)\n- MFA + short-lived tokens; deny-by-default AuthZ\n- Automated encrypted backups + PITR\n- Read replicas: route writes/read-after-write to\n  primary, stale-tolerant reads to replicas",
      "lineHeight": 1.25,
      "autoResize": true
    }
